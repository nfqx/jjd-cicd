<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>Opportunity Managment</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Loss_Reason__c</fieldNames>
        <info>&lt;p&gt;&lt;strong style=&quot;font-size: 10pt; font-family: Arial;&quot;&gt;Document your lost opportunities to increase future wins.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial;&quot;&gt;Identify and log lessons learned&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial;&quot;&gt;Schedule follow-ups if needed&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Closed Lost</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>CloseDate</fieldNames>
        <info>&lt;p&gt;&lt;strong&gt;The opportunity is now finalized and counts toward sales performance.&lt;/strong&gt;&lt;/p&gt;</info>
        <picklistValueName>Closed Won</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Timeframe__c</fieldNames>
        <fieldNames>Type</fieldNames>
        <fieldNames>TypeOfBusiness__c</fieldNames>
        <fieldNames>SalesCategory__c</fieldNames>
        <info>&lt;p&gt;&lt;strong&gt;Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Gather initial customer and opportunity context&lt;/li&gt;&lt;li&gt;Clarify customer needs and general requirements&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Exit Criteria:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Account field &lt;strong&gt;Business Type&lt;/strong&gt; completed ✅&lt;/li&gt;&lt;li&gt;Account field &lt;strong&gt;Sales Category&lt;/strong&gt; completed ✅&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;System Action Required:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 13px;&quot;&gt;➡️&lt;/strong&gt; Click &lt;strong&gt;&amp;quot;Mark Stage as Complete&amp;quot;&lt;/strong&gt; to proceed&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Discovery</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>DailyNumberOfCups__c</fieldNames>
        <fieldNames>EstimatedSalesCoffee__c</fieldNames>
        <fieldNames>EstimatedSalesTea__c</fieldNames>
        <fieldNames>EstimatedSalesHotChocolate__c</fieldNames>
        <info>&lt;p&gt;&lt;strong&gt;Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Validate the business opportunity&lt;/li&gt;&lt;li&gt;Assess feasibility and sales potential&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Exit Criteria:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Estimated volume: Coffee&lt;/strong&gt; completed ✅&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Estimated Sales: Tea&lt;/strong&gt; completed ✅&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Estimated Sales: Hot Chocolate&lt;/strong&gt; completed ✅&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;All relevant qualification data must be documented before proceeding.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;System Action Required:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong style=&quot;font-family: Arial; font-size: 10pt;&quot;&gt; &lt;/strong&gt;&lt;strong style=&quot;font-size: 13px;&quot;&gt;➡️&lt;/strong&gt;&lt;strong style=&quot;font-size: 10pt; font-family: Arial;&quot;&gt; Click &lt;/strong&gt;&lt;strong&gt;&amp;quot;Mark Stage as Complete&amp;quot;&lt;/strong&gt; to proceed&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Qualification</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;&lt;strong&gt;Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Create a customer-specific offer&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Key Actions:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Use &lt;strong&gt;Actions &lt;/strong&gt;&lt;strong style=&quot;font-size: 13px;&quot;&gt;➡️&lt;/strong&gt;&lt;strong&gt; Pricing Configurator&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Define the &lt;strong&gt;Offer Validity Date&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Quotation Phase</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;ul&gt;&lt;li&gt;At least one offer has been sent to the customer&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Stage Change Logic:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt; The stage changes automatically when:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;The customer accepts the offer via the sent email, &lt;strong&gt;or&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;At least one offer is manually confirmed within the Quote record&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Monitor customer feedback and next steps accordingly.&lt;/p&gt;</info>
        <picklistValueName>Quote Sent</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;&lt;strong&gt;Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;A signed offer has been received from the customer&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Exit Check Before Closing:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;All mandatory fields in &lt;strong&gt;“New Customer Setup”&lt;/strong&gt; are completed ✅&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;System Action Required:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Close the opportunity using one of the following Actions:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;➡️ &amp;quot;Won&amp;quot;&lt;/strong&gt; - if the deal was successfully concluded&lt;/li&gt;&lt;li&gt;&lt;strong&gt;➡️ &amp;quot;Lost&amp;quot;&lt;/strong&gt; - if the business did not materialize&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Quote Signed</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;ul&gt;&lt;li&gt;Revise existing offer or create a new one if required&lt;/li&gt;&lt;/ul&gt;</info>
        <picklistValueName>Renegotiation</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>__MASTER__</recordTypeName>
</PathAssistant>
