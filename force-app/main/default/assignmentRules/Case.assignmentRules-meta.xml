<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>ZKS</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Orders</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>1 OR 2</booleanFilter>
            <criteriaItems>
                <field>Case.Subject</field>
                <operation>contains</operation>
                <value>Bestellung</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Subject</field>
                <operation>contains</operation>
                <value>Order</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Offers</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Subject</field>
                <operation>contains</operation>
                <value>Angebot,Offer</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Complaints</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Subject</field>
                <operation>contains</operation>
                <value>Reklamation,Retoure</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
