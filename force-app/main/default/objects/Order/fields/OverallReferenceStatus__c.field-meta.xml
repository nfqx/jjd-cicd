    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>A</fullName>
                <default>false</default>
                <label>Not Referenced</label>
            </value>
            <value>
                <fullName>B</fullName>
                <default>false</default>
                <label>Partially Referenced</label>
            </value>
            <value>
                <fullName>C</fullName>
                <default>false</default>
                <label>Completely Referenced</label>
            </value>
        </valueSetDefinition>
    </valueSet>
