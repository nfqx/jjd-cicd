<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MemoRequestSendRequiresReason</fullName>
    <active>false</active>
    <description>Sending requires an order reason. Inactive until the reason values are available.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Sent&quot;),
  ISPICKVAL(MemoRequestReason__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>MemoRequestReason__c</errorDisplayField>
    <errorMessage>A reason is required before sending.</errorMessage>
</ValidationRule>
