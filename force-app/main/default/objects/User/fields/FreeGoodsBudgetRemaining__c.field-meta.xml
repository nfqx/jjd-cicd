<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FreeGoodsBudgetRemaining__c</fullName>
    <formula>BLANKVALUE(FreeGoodsBudget__c, 0) - BLANKVALUE(FreeGoodsBudgetUsed__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Budget minus used budget. Shown in the Order Wizard.</inlineHelpText>
    <label>Budget Remaining</label>
