        <defaultConnectorLabel>No match</defaultConnectorLabel>
        <rules>
            <name>Postal_code_matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Postal_Code_Assignment.SalesGroupKey__c</leftValueReference>
