        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Get_Postal_Code_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No key on user</defaultConnectorLabel>
        <rules>
            <name>User_holds_key</name>
