    </decisions>
    <description>Fills the chain head lookups on the lead automatically: when a chain parent account is selected, the corresponding chain head is copied from that account (Condition Chain Head from Account.HeadOfConditionChain__c, Statistic Chain Head from Account.StatisticChainHead__c). When a parent is cleared, the head is cleared as well.</description>
    <environments>Default</environments>
    <formulas>
        <name>fConditionParentChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() || ISCHANGED({!$Record.ConditionChainParent__c})</expression>
    </formulas>
    <formulas>
        <name>fStatisticParentChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() || ISCHANGED({!$Record.StatisticChainParent__c})</expression>
    </formulas>
    <interviewLabel>Lead - Set Chain Heads {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Set Chain Heads</label>
