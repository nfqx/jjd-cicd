<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Extension_Type</name>
        <label>Extension Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>pdf</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_FileExtension</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>pdf</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_pdf_Case</targetReference>
            </connector>
            <label>pdf</label>
        </rules>
        <rules>
            <name>mp3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_FileExtension</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>mp3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_mp3_Case</targetReference>
            </connector>
            <label>mp3</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fx_FileExtension</name>
        <dataType>String</dataType>
        <expression>LOWER(
    RIGHT(
        {!$Record.PathOnClient}, 
        LEN({!$Record.PathOnClient}) - FIND(&quot;.&quot;, {!$Record.PathOnClient})
    )
)</expression>
    </formulas>
    <interviewLabel>ContentVersion - File Extension Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ContentVersion - File Extension Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Email_Message</name>
        <label>Email Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Extension_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FirstPublishLocationId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailMessage</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_mp3_Case</name>
        <label>Update mp3 Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email_Message.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Has_Attachment__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>isMP3__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_pdf_Case</name>
        <label>Update pdf Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email_Message.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Has_Attachment__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>isPDF__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Email_Message</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FirstPublishLocationId</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>02s</stringValue>
            </value>
        </filters>
        <object>ContentVersion</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
