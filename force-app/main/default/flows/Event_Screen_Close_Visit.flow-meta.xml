    <formulas>
        <name>varAccountIdFromEvent</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Get_Event.WhatId}, &quot;001&quot;),
  {!Get_Event.WhatId},
  NULL
)</expression>
    </formulas>
