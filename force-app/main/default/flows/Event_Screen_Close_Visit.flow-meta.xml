    <formulas>
        <name>frmCurrentGoal</name>
        <dataType>String</dataType>
        <expression>TRIM(
    LEFT(
        {!varRemainingGoals},
        FIND(&quot;;&quot;, {!varRemainingGoals}) - 1
    )
)</expression>
    </formulas>
    <formulas>
        <name>frmRemainingGoals</name>
        <dataType>String</dataType>
        <expression>TRIM(
    MID(
        {!varRemainingGoals},
        FIND(&quot;;&quot;, {!varRemainingGoals}) + 1,
        LEN({!varRemainingGoals})
    )
)</expression>
    </formulas>
    <formulas>
        <name>varAccountIdFromEvent</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Get_Event.WhatId}, &quot;001&quot;),
  {!Get_Event.WhatId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>varContactIdFromEvent</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Get_Event.WhoId}, &quot;003&quot;),
  {!Get_Event.WhoId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>varLeadIdfromEvent</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Get_Event.WhoId}, &quot;00Q&quot;),
  {!Get_Event.WhoId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>varOppIdFromEvent</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Get_Event.WhatId}, &quot;006&quot;),
