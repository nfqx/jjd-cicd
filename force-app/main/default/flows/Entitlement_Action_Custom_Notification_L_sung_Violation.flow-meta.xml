<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Default_ZKS_Supervisor</name>
        <label>Default ZKS Supervisor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>supervisorGroupName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ZKS_Supervisors</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>VIP_Account_or_Standard</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Standard_Text_to_Notification_Variables</name>
        <label>Standard Text to Notification Variables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>notificationBodyInput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_notificationBodyInputStandard</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>notificationTitleInput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_notificationTitleInputStandard</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Custom_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>VIP_to_Notification_Variables</name>
        <label>VIP to Notification Variables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>notificationBodyInput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_notificationBodyInputVIP</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>notificationTitleInput</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_notificationTitleInputVIP</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Custom_Notification</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Routing_Helper_was_found_or_Not</name>
        <label>Routing Helper was found or Not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Default_ZKS_Supervisor</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, there is no Helper Id</defaultConnectorLabel>
        <rules>
            <name>Yes_Routing_Helper_was_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>routingHelperId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VIP_Account_or_Standard</targetReference>
            </connector>
            <label>Yes, Routing Helper was found</label>
        </rules>
    </decisions>
    <decisions>
        <name>VIP_Account_or_Standard</name>
        <label>VIP Account or Standard</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Standard_Text_to_Notification_Variables</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard</defaultConnectorLabel>
        <rules>
            <name>VIP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Initial_Case_Record_Details.Account_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>VIP Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VIP_to_Notification_Variables</targetReference>
            </connector>
            <label>VIP</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fx_notificationBodyInputStandard</name>
        <dataType>String</dataType>
        <expression>&apos;Der Kundenvorgang ist innerhalb des Zeitrahmens nicht geschlossen worden und befindet sich noch im Status &apos;+TEXT({!Initial_Case_Record_Details.Status})</expression>
    </formulas>
    <formulas>
        <name>fx_notificationBodyInputVIP</name>
        <dataType>String</dataType>
        <expression>&apos;(VIP) Der Kundenvorgang ist innerhalb des Zeitrahmens nicht geschlossen worden und befindet sich noch im Status &apos; +TEXT({!Initial_Case_Record_Details.Status})</expression>
    </formulas>
    <formulas>
        <name>fx_notificationTitleInputStandard</name>
        <dataType>String</dataType>
        <expression>&apos;Case noch nicht gelöst&apos;</expression>
    </formulas>
    <formulas>
        <name>fx_notificationTitleInputVIP</name>
        <dataType>String</dataType>
        <expression>&apos;(VIP) Case noch nicht gelöst &apos;</expression>
    </formulas>
    <interviewLabel>Entitlement_Action_Custom_Notification_L_sung_Violation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Entitlement Action - Custom Notification - Lösung - Violation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Initial_Case_Record_Details</name>
        <label>Initial Case Record Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Routing_Helper_for_Supervisor</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>case_id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Routing_Helper_for_Supervisor</name>
        <label>Routing Helper for Supervisor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Routing_Helper_was_found_or_Not</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Initial_Case_Record_Details.Type</elementReference>
            </value>
        </filters>
        <filters>
            <field>SubType__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Initial_Case_Record_Details.SubType__c</elementReference>
            </value>
        </filters>
        <object>Routing_Helper__mdt</object>
        <outputAssignments>
            <assignToReference>routingHelperId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>supervisorGroupName</assignToReference>
            <field>Supervisor__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Initial_Case_Record_Details</targetReference>
        </connector>
    </start>
