    <formulas>
        <name>fx_CheckSubjectForPhoneCalls</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    /* Matches &apos;Anruf von +[Any Number] (ohne Nachricht)&apos; */
    REGEX({!initialCaseRecord.Subject}, &quot;Anruf von \\+\\d+ \\(ohne Nachricht\\)&quot;),

    /* Matches &apos;Nachricht von +[Any Number] - Dauer: X Sekunden&apos; where X &lt;= 8 */
    AND(
        REGEX({!initialCaseRecord.Subject}, &quot;Nachricht von \\+\\d+ - Dauer: (\\d{1,2}) Sekunden&quot;),
        VALUE(MID({!initialCaseRecord.Subject}, FIND(&quot;Dauer: &quot;, {!initialCaseRecord.Subject}) + 7, FIND(&quot; Sekunden&quot;, {!initialCaseRecord.Subject}) - FIND(&quot;Dauer: &quot;, {!initialCaseRecord.Subject}) - 7)) &lt;= 8
    )
)</expression>
    </formulas>
