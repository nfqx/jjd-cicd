    <formulas>
        <name>defaultMainGoal</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!varSourceType},

    &quot;Lead&quot;,
    &quot;New Customer Acquisition / First Visit&quot;,

    &quot;Opportunity&quot;,
    &quot;Contract or Commercial Terms Negotiation&quot;,

    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>defaultMainGoalLocked</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    {!varSourceType} = &quot;Lead&quot;,
    {!varSourceType} = &quot;Opportunity&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultEndDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!Start_Date_Time}   + (1 / 24)</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultGoals</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!varSourceType},

    &quot;Lead&quot;,
    &quot;New Customer Acquisition / First Visit&quot;,

    &quot;Opportunity&quot;,
    &quot;Contract or Commercial Terms Negotiation&quot;,

    &quot;Account&quot;,
    &quot;Existing Customer Relationship Management&quot;,

    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultLocation</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!varSourceType},

    &quot;Account&quot;,
    TRIM(
        {!Get_Account.ShippingStreet}
        &amp; &quot;, &quot;
        &amp; {!Get_Account.ShippingPostalCode}
        &amp; &quot; &quot;
        &amp; {!Get_Account.ShippingCity}
    ),

    &quot;Opportunity&quot;,
    TRIM(
        {!Get_Opportunity.Account.ShippingStreet}
        &amp; &quot;, &quot;
        &amp; {!Get_Opportunity.Account.ShippingPostalCode}
        &amp; &quot; &quot;
        &amp; {!Get_Opportunity.Account.ShippingCity}
    ),

    &quot;Lead&quot;,
    TRIM(
        {!Get_Lead.Street}
        &amp; &quot;, &quot;
        &amp; {!Get_Lead.PostalCode}
        &amp; &quot; &quot;
        &amp; {!Get_Lead.City}
    ),

    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultSubject</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!varSourceType},

    &quot;Lead&quot;,
    &quot;Besuch: &quot; &amp; {!Get_Lead.Name} &amp; &quot; - &quot; &amp; {!Get_Lead.Company} &amp; &quot; (Lead)&quot;,

    &quot;Account&quot;,
    &quot;Besuch: &quot; &amp; {!Get_Account.Name} &amp; &quot; (Account)&quot;,

    &quot;Opportunity&quot;,
    &quot;Besuch: &quot; &amp; {!Get_Opportunity.Name} &amp; &quot; (Opportunity)&quot;,

    &quot;Besuch:&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaWhatId</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!varSourceType},

    &quot;Account&quot;,
    {!recordId},

    &quot;Opportunity&quot;,
    {!recordId},

    &quot;Lead&quot;,
    &quot;&quot;,

    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaWhoId</name>
        <dataType>String</dataType>
        <expression>IF(
    {!varSourceType} = &quot;Lead&quot;,
    {!recordId},
    {!Responsible_Contact.selectedChoiceValues}
)</expression>
    </formulas>
    <formulas>
        <name>varSourceType</name>
        <dataType>String</dataType>
        <expression>CASE(
    LEFT({!recordId}, 3),
    &quot;001&quot;, &quot;Account&quot;,
    &quot;006&quot;, &quot;Opportunity&quot;,
    &quot;00Q&quot;, &quot;Lead&quot;,
    &quot;Unknown&quot;
)</expression>
    </formulas>
