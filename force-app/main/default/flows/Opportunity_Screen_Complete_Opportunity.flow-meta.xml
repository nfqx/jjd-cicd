    <decisions>
        <name>Determine_Opportunity_Completion_Path</name>
        <label>Determine Opportunity Completion Path</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Master_Data_Validation_Successful</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaHasMasterDataValidationCase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaMasterDataValidationSuccessful</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp</targetReference>
            </connector>
            <label>Master Data Validation Successful</label>
        </rules>
        <rules>
            <name>Validation_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaHasMasterDataValidationCase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaHasMasterDataValidationCase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp_2</targetReference>
            </connector>
            <label>Validation Pending</label>
        </rules>
        <rules>
            <name>No_Validation_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaHasMasterDataValidationCase</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opp_3</targetReference>
            </connector>
            <label>No Validation Required</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>formulaHasMasterDataValidationCase</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
    ISBLANK({!Get_Opportunity.MasterDataValidationCase__c})
)</expression>
    </formulas>
    <formulas>
        <name>formulaMasterDataValidationSuccessful</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    {!formulaHasMasterDataValidationCase},
    TEXT({!Get_Opportunity.MasterDataValidationCase__r.Status}) = &quot;Closed&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaTargetOpportunityStage</name>
        <dataType>String</dataType>
        <expression>IF(
    {!formulaHasMasterDataValidationCase},
    IF(
        {!formulaMasterDataValidationSuccessful},
        &quot;Closed Won&quot;,
        &quot;Master Data Validation&quot;
    ),
    &quot;Closed Won&quot;
)</expression>
    </formulas>
