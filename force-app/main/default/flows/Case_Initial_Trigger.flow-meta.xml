    <environments>Default</environments>
    <formulas>
        <name>fx_CheckSubjectForPhoneCalls</name>
        <dataType>Boolean</dataType>
        <expression>/* Matches &apos;Nachricht von +[Any Number] - Dauer: X Sekunden&apos; where X &lt;= 8 */
AND(
        REGEX({!$Record.Subject}, &quot;Nachricht von \\+\\d+ - Dauer: (\\d{1,2}) Sekunden&quot;),
        VALUE(MID({!$Record.Subject}, FIND(&quot;Dauer: &quot;, {!$Record.Subject}) + 7, FIND(&quot; Sekunden&quot;, {!$Record.Subject}) - FIND(&quot;Dauer: &quot;, {!$Record.Subject}) - 7)) &lt;= 8)</expression>
    </formulas>
