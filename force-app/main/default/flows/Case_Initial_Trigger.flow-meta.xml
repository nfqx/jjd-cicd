            <name>Voicemail_Cases_ohne_Nachricht</name>
            <conditionLogic>(1 AND 2 ) OR (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Voicemail</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>ohne Nachricht</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fx_CheckSubjectForPhoneCalls</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>JJD_Non_Routable_Queue</targetReference>
            </connector>
            <label>Voicemail Cases ohne Nachricht</label>
        </rules>
        <rules>
            <name>Fax</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Faxempfang</stringValue>
                </rightValue>
            </conditions>
