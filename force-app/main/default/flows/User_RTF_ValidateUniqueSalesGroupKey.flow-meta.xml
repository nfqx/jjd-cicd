    <customErrors>
        <name>Error_Duplicate_Key</name>
        <label>Duplicate sales group key</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <customErrorMessages>
            <errorMessage>This sales group key is already assigned to {!Get_Other_User_With_Same_Key.Name}. A key can belong to one active user only. Remove it there first, or use a different key.</errorMessage>
            <fieldSelection>SalesGroupKey__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Decision_Key_Already_Taken</name>
        <label>Key already taken?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Key is free</defaultConnectorLabel>
        <rules>
            <name>Key_taken</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Other_User_With_Same_Key.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Duplicate_Key</targetReference>
            </connector>
            <label>Key taken</label>
        </rules>
    </decisions>
    <description>Blocks saving a user when the sales group key is already held by another active user. A validation rule cannot do this because it only sees its own record.</description>
    <environments>Default</environments>
    <label>User RTF Validate Unique Sales Group Key</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
