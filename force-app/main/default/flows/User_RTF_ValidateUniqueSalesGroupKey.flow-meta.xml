        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Key_Already_Taken</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SalesGroupKey__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SalesGroupKey__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
