<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>InvoiceFound</name>
        <label>Invoice Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetLatestInvoice</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAccountLastInvoiceDate</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Ensures that the LastInvoiceDate__c field on the Account always reflects the most recent invoice date from the associated Invoices.
Jira Ticket: JJDSF-1129</description>
    <environments>Default</environments>
    <interviewLabel>Invoice - Sync Last Invoice Date to Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice - Sync Last Invoice Date to Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetLatestInvoice</name>
        <label>Get Latest Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>InvoiceFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillingAccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.BillingAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Invoice</object>
        <sortField>InvoiceDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>UpdateAccountLastInvoiceDate</name>
        <label>Update Account Last Invoice Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>LastInvoiceDate__c</field>
            <value>
                <elementReference>GetLatestInvoice.InvoiceDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.BillingAccount</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetLatestInvoice</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillingAccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>InvoiceDate</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Invoice</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
